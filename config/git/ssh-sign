#!/bin/sh
# Git gpg.ssh.program: use forwarded agent over SSH, 1Password locally.

if [ -n "${SSH_CLIENT:-}${SSH_CONNECTION:-}${SSH_TTY:-}" ]; then
	exec ssh-keygen "$@"
fi

case "$(uname -s)" in
Darwin)
	op_ssh_sign="/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
	;;
*)
	op_ssh_sign="/opt/1Password/op-ssh-sign"
	;;
esac

if [ ! -x "$op_ssh_sign" ]; then
	echo "ssh-sign: op-ssh-sign not found at $op_ssh_sign" >&2
	exit 1
fi

exec "$op_ssh_sign" "$@"
