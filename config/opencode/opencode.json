{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": "notify",
    "model": "opencode-go/deepseek-v4-flash",
    "small_model": "opencode/hy3-free",
    "formatter": true,
    "lsp": true,
    "permission": {
        "external_directory": {
            "~/Documents/Obsidian/Personal Vault/Agent Memory/**": "allow"
        }
    },
    "agent": {
        "build": {
            "model": "opencode-go/deepseek-v4-flash"
        },
        "plan": {
            "model": "xai/grok-4.6"
        },
        "explore": {
            "model": "opencode-go/deepseek-v4-flash"
        }
    },
    "compaction": {
        "prune": true
    },
    "mcp": {
        "playwright": {
            "type": "local",
            "command": ["npx", "@playwright/mcp@latest", "--browser", "chromium"]
        }
    }
}
