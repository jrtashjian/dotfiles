{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": "notify",
    "model": "opencode/big-pickle",
    "small_model": "opencode/north-mini-code-free",
    "formatter": true,
    "lsp": true,
    "permission": {
        "external_directory": {
            "~/Documents/Obsidian/Personal Vault/Agent Memory/**": "allow"
        }
    },
    "agent": {
        "build": {
            "model": "opencode/big-pickle"
        },
        "plan": {
            "model": "xai/grok-4.5"
        },
        "explore": {
            "model": "opencode/deepseek-v4-flash-free"
        }
    },
    "compaction": {
        "prune": true
    }
}
